//Test Bench

module tb_comparator;
reg [3:0] a, b;
wire gt, lt, eq;
  
comparator_4bit uut (.a(a),.b(b),.gt(gt),.lt(lt),.eq(eq));

initial begin
    $dumpfile("comparator.vcd");
    $dumpvars(0,tb_comparator);

      a=4'b0000; b=4'b0000;
  #10;a=4'b0011; b=4'b0001;
  #10;a=4'b0100; b=4'b0110;
  #10;a=4'b1010; b=4'b1010; 
  #10;a=4'b1111; b=4'b0111; 
  #10;a=4'b0001; b=4'b1000; 
  #10;$finish;
end

initial begin
    $monitor("time=%0t a=%b b=%b gt=%b lt=%b eq=%b",
             $time,a,b,gt,lt,eq);
end
endmodule
